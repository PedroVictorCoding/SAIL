<?xml version="1.0" encoding="utf-8"?>
<!-- Debug only: allow plain HTTP, and trust certificate authorities the owner installed on
     the phone (Settings › Security › Install from storage), so a development SAIL with its
     self-signed "SAIL-local" certificate can be reached. Release keeps HTTPS with system CAs. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
