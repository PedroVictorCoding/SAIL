# Generated by Cargo
# will have compiled files and executables
debug
target

# Large model weights
models/
models
models/*.gguf
*.gguf
models/*.sha256
*.sha256

# Rust source module, not model weights (see crates/sail-capital/src/lib.rs)
!crates/sail-capital/src/models/
!crates/sail-capital/src/models/**

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Local speech runtimes, downloaded weights and TLS private keys
.venv-voice/
models/voice/
.local/
__pycache__/

# Agent scratch state (worktrees live here) and runtime job logs. Shared Claude Code
# project settings (graphify hooks) and skills stay tracked.
.claude/*
!.claude/settings.json
!.claude/skills/
logs/

# Credentials and machine-specific environment (keep sanitized templates public)
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
id_rsa
id_ed25519
credentials.json
service-account*.json
secrets/
.secrets/
.aws/
.ssh/

# Private runtime data, sessions and local tooling
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.log
.venv/
venv/
node_modules/
playwright-report/
test-results/
android/local.properties
android/key.properties

# graphify code graph: built per worktree by scripts/graphify-refresh.sh (see AGENTS.md).
# No trailing slash: it is a symlink to the HDD store, which `graphify-out/` would not match.
graphify-out
