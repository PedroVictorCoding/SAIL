{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sail:inference:v1",
  "title": "SAIL local inference v1",
  "$ref": "#/$defs/InferenceRequest",
  "$defs": {
    "FunctionCall": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "arguments": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "additionalProperties": false
    },
    "ToolCall": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "function"
        },
        "function": {
          "$ref": "#/$defs/FunctionCall"
        }
      },
      "required": [
        "id",
        "type",
        "function"
      ],
      "additionalProperties": false
    },
    "ContentPart": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "text"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "image_url"
            },
            "image_url": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "pattern": "^data:image/(png|jpeg);base64,"
                }
              },
              "required": [
                "url"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "image_url"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Message": {
      "type": "object",
      "properties": {
        "role": {
          "enum": [
            "system",
            "user",
            "assistant",
            "tool"
          ]
        },
        "content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ContentPart"
              }
            }
          ]
        },
        "tool_calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToolCall"
          }
        },
        "tool_call_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "role",
        "content"
      ],
      "additionalProperties": false
    },
    "ToolDefinition": {
      "type": "object",
      "properties": {
        "type": {
          "const": "function"
        },
        "function": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "parameters": {
              "type": "object"
            }
          },
          "required": [
            "name",
            "parameters"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "function"
      ],
      "additionalProperties": false
    },
    "Generation": {
      "type": "object",
      "properties": {
        "max_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        }
      },
      "required": [
        "max_tokens",
        "temperature"
      ],
      "additionalProperties": false
    },
    "InferenceRequest": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Message"
          },
          "minItems": 1,
          "maxItems": 128
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToolDefinition"
          },
          "maxItems": 8
        },
        "tool_choice": {
          "enum": [
            "auto",
            "none"
          ]
        },
        "generation": {
          "$ref": "#/$defs/Generation"
        }
      },
      "required": [
        "version",
        "request_id",
        "messages"
      ],
      "additionalProperties": false
    },
    "Usage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "output_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "input_tokens",
        "output_tokens"
      ]
    },
    "Timings": {
      "type": "object",
      "properties": {
        "queue_ms": {
          "type": "integer",
          "minimum": 0
        },
        "first_token_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "inference_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "queue_ms",
        "first_token_ms",
        "inference_ms"
      ]
    },
    "InferenceResponse": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "model": {
          "type": "string"
        },
        "message": {
          "$ref": "#/$defs/Message"
        },
        "finish_reason": {
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        },
        "timings": {
          "$ref": "#/$defs/Timings"
        }
      },
      "required": [
        "version",
        "request_id",
        "model",
        "message",
        "finish_reason",
        "usage",
        "timings"
      ]
    },
    "InferenceError": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "code": {
          "enum": [
            "unsupported_version",
            "invalid_request",
            "invalid_configuration",
            "forbidden_endpoint",
            "unknown_model",
            "unsupported_capability",
            "resource_limit",
            "busy",
            "queue_timeout",
            "cancelled",
            "deadline_exceeded",
            "backend_unavailable",
            "backend_protocol",
            "consumer_closed",
            "shutting_down"
          ]
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "version",
        "code",
        "message",
        "retryable"
      ]
    },
    "InferenceEvent": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "version": {
              "const": 1
            },
            "request_id": {
              "type": "string",
              "format": "uuid"
            },
            "type": {
              "const": "started"
            },
            "model": {
              "type": "string"
            }
          },
          "required": [
            "version",
            "request_id",
            "type",
            "model"
          ]
        },
        {
          "type": "object",
          "properties": {
            "version": {
              "const": 1
            },
            "request_id": {
              "type": "string",
              "format": "uuid"
            },
            "type": {
              "const": "text_delta"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "version",
            "request_id",
            "type",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "version": {
              "const": 1
            },
            "request_id": {
              "type": "string",
              "format": "uuid"
            },
            "type": {
              "const": "tool_delta"
            },
            "index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 7
            },
            "delta": {}
          },
          "required": [
            "version",
            "request_id",
            "type",
            "index",
            "delta"
          ]
        },
        {
          "type": "object",
          "properties": {
            "version": {
              "const": 1
            },
            "request_id": {
              "type": "string",
              "format": "uuid"
            },
            "type": {
              "const": "completed"
            },
            "response": {
              "$ref": "#/$defs/InferenceResponse"
            }
          },
          "required": [
            "version",
            "request_id",
            "type",
            "response"
          ]
        },
        {
          "type": "object",
          "properties": {
            "version": {
              "const": 1
            },
            "request_id": {
              "type": "string",
              "format": "uuid"
            },
            "type": {
              "const": "failed"
            },
            "error": {
              "$ref": "#/$defs/InferenceError"
            }
          },
          "required": [
            "version",
            "request_id",
            "type",
            "error"
          ]
        }
      ]
    },
    "ModelCapabilities": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "text": {
          "type": "boolean"
        },
        "vision": {
          "type": "boolean"
        },
        "tools": {
          "type": "boolean"
        },
        "context_tokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "model",
        "text",
        "vision",
        "tools",
        "context_tokens"
      ]
    },
    "ModelStatus": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "state": {
          "enum": [
            "uninitialized",
            "starting",
            "ready",
            "unavailable",
            "stopped"
          ]
        },
        "model": {
          "type": "string"
        },
        "capabilities": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelCapabilities"
            },
            {
              "type": "null"
            }
          ]
        },
        "requested_backend": {
          "enum": [
            "cpu",
            "vulkan"
          ]
        },
        "observed_backend": {
          "anyOf": [
            {
              "enum": [
                "cpu",
                "vulkan"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "owned_process": {
          "type": "boolean"
        },
        "process_id": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "last_error": {
          "anyOf": [
            {
              "$ref": "#/$defs/InferenceError"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "version",
        "state",
        "model",
        "capabilities",
        "requested_backend",
        "observed_backend",
        "owned_process",
        "process_id",
        "last_error"
      ]
    },
    "ResourceLimits": {
      "type": "object",
      "properties": {
        "max_input_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_response_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_image_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "queue_timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "inference_timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "max_parallel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "max_queued": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "max_images": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        }
      },
      "required": [
        "max_input_bytes",
        "max_response_bytes",
        "max_image_bytes",
        "max_output_tokens",
        "queue_timeout_ms",
        "inference_timeout_ms",
        "max_parallel",
        "max_queued",
        "max_images"
      ],
      "additionalProperties": false
    },
    "InferenceMetrics": {
      "type": "object",
      "properties": {
        "submitted": {
          "type": "integer",
          "minimum": 0
        },
        "completed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "cancelled": {
          "type": "integer",
          "minimum": 0
        },
        "rejected": {
          "type": "integer",
          "minimum": 0
        },
        "active": {
          "type": "integer",
          "minimum": 0
        },
        "queued": {
          "type": "integer",
          "minimum": 0
        },
        "total_inference_ms": {
          "type": "integer",
          "minimum": 0
        },
        "last_first_token_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "submitted",
        "completed",
        "failed",
        "cancelled",
        "rejected",
        "active",
        "queued",
        "total_inference_ms",
        "last_first_token_ms"
      ]
    },
    "MindStatus": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "accepting_requests": {
          "type": "boolean"
        },
        "models": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ModelStatus"
          }
        },
        "metrics": {
          "$ref": "#/$defs/InferenceMetrics"
        },
        "limits": {
          "$ref": "#/$defs/ResourceLimits"
        }
      },
      "required": [
        "version",
        "accepting_requests",
        "models",
        "metrics",
        "limits"
      ]
    }
  }
}
